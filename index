<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>漢使研 多言語翻訳データベース</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --ink:#1a1714;--ink2:#3d3d3a;--ink3:#6b6560;--ink4:#9c9690;
  --bg:#f5f3ef;--paper:#fff;--border:#e2ddd6;--border2:#c8c2b8;
  --teal:#0f7b63;--teal-l:#e8f5f1;--teal-d:#085041;
  --amber:#8a5a0a;--amber-l:#fdf3e1;
  --pur:#3d2a8a;--pur-l:#eeebfa;
  --blue:#1a5fa8;--blue-l:#e8f0fa;
  --green:#2d6b1a;--green-l:#eaf5e8;
  --red:#8a1a0a;--red-l:#faeae8;
  --pink:#8a1a5a;--pink-l:#faeaf2;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Hiragino Sans','Noto Sans JP',sans-serif;background:var(--bg);color:var(--ink);font-size:13px;line-height:1.6;overflow-x:hidden}
.nav{background:var(--ink);color:#fff;padding:0 14px;height:50px;display:flex;align-items:center;gap:3px;position:sticky;top:0;z-index:100;overflow-x:auto}
.nav-logo{font-size:13px;font-weight:700;letter-spacing:.04em;color:#fff;margin-right:12px;white-space:nowrap;flex-shrink:0}
.ntab{padding:5px 11px;font-size:11px;font-weight:700;border-radius:20px;cursor:pointer;color:rgba(255,255,255,.5);border:none;background:transparent;font-family:inherit;white-space:nowrap;flex-shrink:0;transition:all .15s}
.ntab.on,.ntab:hover{color:#fff}
.ntab.on{background:var(--teal)}
.panel{display:none;min-height:calc(100vh - 50px)}
.panel.on{display:block}
.sec{max-width:1000px;margin:0 auto;padding:20px 18px}
.lbl{font-size:10px;font-weight:700;letter-spacing:.14em;color:var(--teal);text-transform:uppercase;margin-bottom:4px}
.h2{font-size:17px;font-weight:700;margin-bottom:5px}
.sub{font-size:12px;color:var(--ink3);margin-bottom:14px;line-height:1.7}
.btn{padding:6px 12px;border:none;border-radius:6px;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer}
.btn-p{background:var(--ink);color:#fff}
.btn-t{background:var(--teal);color:#fff}
.btn-s{background:var(--paper);border:1px solid var(--border2);color:var(--ink)}
/* source cards */
.src-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px;margin-bottom:16px}
.src-card{background:var(--paper);border:1px solid var(--border);border-radius:9px;padding:11px 13px;cursor:pointer;transition:border-color .15s;position:relative}
.src-card.on{border-color:var(--teal);background:var(--teal-l)}
.src-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:5px}
.src-name{font-size:12px;font-weight:700;margin-bottom:2px}
.src-info{font-size:10px;color:var(--ink3);line-height:1.4}
.src-cnt{position:absolute;top:9px;right:10px;font-size:10px;font-weight:700;padding:1px 6px;border-radius:10px;background:var(--bg);color:var(--ink3)}
.src-card.on .src-cnt{background:var(--teal);color:#fff}
/* stats */
.stats-bar{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}
.stat{background:var(--paper);border:1px solid var(--border);border-radius:8px;padding:7px 13px;min-width:80px}
.stat-v{font-size:19px;font-weight:700;color:var(--teal);line-height:1}
.stat-l{font-size:10px;color:var(--ink3);margin-top:2px}
/* filters */
.filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;align-items:center}
.filters input,.filters select{padding:6px 9px;border:1px solid var(--border2);border-radius:6px;font-family:inherit;font-size:12px;background:var(--paper);color:var(--ink);outline:none}
.filters input{flex:1;min-width:160px}
.filters input:focus,.filters select:focus{border-color:var(--teal)}
/* lang pills */
.lang-pills{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px}
.lp{padding:3px 10px;border-radius:16px;font-size:11px;font-weight:700;cursor:pointer;border:1px solid var(--border2);background:var(--paper);color:var(--ink3);transition:all .15s;white-space:nowrap}
.lp.on{background:var(--ink);color:#fff;border-color:var(--ink)}
/* table */
.tbl-wrap{overflow-x:auto;border-radius:10px;border:1px solid var(--border);max-height:65vh;overflow-y:auto}
table{width:100%;border-collapse:collapse;background:var(--paper);font-size:12px}
thead{position:sticky;top:0;z-index:10}
thead tr{background:var(--bg)}
th{padding:7px 9px;text-align:left;font-size:10px;font-weight:700;letter-spacing:.06em;color:var(--ink3);border-bottom:2px solid var(--border2);white-space:nowrap;cursor:pointer;user-select:none}
th:hover{color:var(--ink)}
th.sorted{color:var(--teal)}
td{padding:6px 9px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.5}
td.jp{font-weight:600;color:var(--ink);min-width:130px}
td.src-tag,td.cat-tag,td.qno{white-space:nowrap}
td.lang-val{font-size:11px;color:var(--ink2);min-width:120px;max-width:200px;word-break:break-word}
tr:hover td{background:#faf9f7}
tr:last-child td{border-bottom:none}
mark{background:#fef3c7;border-radius:2px;padding:0 1px}
.empty{text-align:center;padding:36px;color:var(--ink3)}
/* badges */
.bdg{display:inline-block;font-size:10px;font-weight:700;padding:2px 6px;border-radius:9px;white-space:nowrap}
.bdg-oden{background:#fdf3e1;color:#8a5a0a}
.bdg-taxi{background:#e8f0fa;color:#1a5fa8}
.bdg-life{background:#eaf5e8;color:#2d6b1a}
.bdg-q{background:#eeebfa;color:#3d2a8a}
.bdg-iv{background:#faeaf2;color:#8a1a5a}
/* copy */
.cp{font-size:10px;padding:1px 5px;border-radius:4px;border:1px solid var(--border2);background:var(--bg);color:var(--ink3);cursor:pointer;margin-left:3px;opacity:0;transition:opacity .15s;vertical-align:middle}
td:hover .cp{opacity:1}
.cp:hover{background:var(--teal-l);border-color:var(--teal);color:var(--teal)}
/* upload */
.upload-zone{border:2px dashed var(--border2);border-radius:9px;padding:16px;text-align:center;cursor:pointer;background:var(--paper);transition:all .15s;position:relative;margin-bottom:12px}
.upload-zone:hover,.upload-zone.over{border-color:var(--teal);background:var(--teal-l)}
.upload-zone input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
.imp-log{background:var(--bg);border-radius:7px;padding:10px;font-size:11px;color:var(--ink3);font-family:monospace;max-height:100px;overflow-y:auto;margin-top:6px;display:none}
/* detail */
.det-card{background:var(--paper);border:1px solid var(--border);border-radius:9px;padding:12px 14px;margin-bottom:9px}
</style>
</head>
<body>
<nav class="nav">
  <div class="nav-logo">🌐 漢使研 翻訳DB</div>
  <button class="ntab on" onclick="gp(0,this)">検索・一覧</button>
  <button class="ntab" onclick="gp(1,this)">詳細表示</button>
  <button class="ntab" onclick="gp(2,this)">インタビューQ</button>
  <button class="ntab" onclick="gp(3,this)">統計・概要</button>
  <button class="ntab" onclick="gp(4,this)">Excel追加</button>
</nav>

<!-- P0: 検索 -->
<div class="panel on" id="p0">
<div class="sec">
  <div class="lbl">多言語翻訳データベース 統合完全版</div>
  <div class="h2" style="margin-bottom:3px">全資料を横断して検索</div>
  <div class="sub">静岡おでんおがわ・川根本町お出かけ号・川根本町便利帳・外国人アンケート票（5言語）を統合</div>
  <div class="stats-bar" id="stats-bar"></div>
  <div class="src-grid" id="src-cards"></div>
  <div class="lang-pills" id="lang-pills"></div>
  <div class="filters">
    <input type="text" id="kw" placeholder="キーワード検索（日本語・翻訳文どちらでも）…" oninput="render()">
    <select id="cat-sel" onchange="render()"><option value="">すべてのカテゴリ</option></select>
    <select id="sort-sel" onchange="render()">
      <option value="src">資料順</option>
      <option value="jp">日本語順</option>
      <option value="cat">カテゴリ順</option>
    </select>
    <span style="font-size:12px;color:var(--ink3)" id="cnt-lbl">— 件</span>
    <button class="btn btn-s" onclick="expCSV()">📥 CSV</button>
  </div>
  <div class="tbl-wrap">
    <table><thead><tr id="thead-row"></tr></thead><tbody id="tbody"></tbody></table>
  </div>
</div>
</div>

<!-- P1: 詳細 -->
<div class="panel" id="p1">
<div class="sec">
  <div class="lbl">詳細表示</div>
  <div class="h2" style="margin-bottom:10px">1件をすべての言語で確認</div>
  <div class="filters" style="margin-bottom:10px">
    <input type="text" id="det-kw" placeholder="日本語原文で絞り込み…" oninput="renderDetail()">
    <select id="det-src" onchange="renderDetail()"><option value="">すべての資料</option></select>
    <select id="det-cat" onchange="renderDetail()"><option value="">すべてのカテゴリ</option></select>
  </div>
  <div id="det-list"></div>
</div>
</div>

<!-- P2: インタビューQ -->
<div class="panel" id="p2">
<div class="sec">
  <div class="lbl">インタビューガイド</div>
  <div class="h2" style="margin-bottom:10px">FW用インタビュー質問集</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px" id="iv-list"></div>
</div>
</div>

<!-- P3: 統計 -->
<div class="panel" id="p3">
<div class="sec">
  <div class="lbl">統計・概要</div>
  <div class="h2" style="margin-bottom:14px">翻訳データの全体像</div>
  <div id="stats-detail"></div>
</div>
</div>

<!-- P4: Excel追加 -->
<div class="panel" id="p4">
<div class="sec">
  <div class="lbl">Excelファイル追加</div>
  <div class="h2" style="margin-bottom:6px">翻訳Excelをドロップして追加</div>
  <div class="sub">oden_tagengo.xlsx・taxi_kawane_tagengo.xlsx・Kawane_benricho_tagengo.xlsx をドロップすると実データで上書き補完されます。</div>
  <div class="upload-zone" id="drop2" onclick="document.getElementById('fi2').click()">
    <input type="file" id="fi2" accept=".xlsx,.xls,.csv" multiple onchange="loadFiles(this.files)">
    <div style="font-size:26px;margin-bottom:5px">📂</div>
    <strong>ここにドロップ または クリック</strong>
    <p style="font-size:11px;color:var(--ink3);margin-top:3px">複数ファイル同時対応</p>
  </div>
  <div class="imp-log" id="imp-log"></div>
  <div id="src-manage"></div>
</div>
</div>

<script>
// ━━ 定数 ━━
const LANGS=['日本語','中国語（簡）','中国語（繁）','英語','ベトナム語','ミャンマー語','タイ語','インドネシア語','韓国語'];
const LS={'日本語':'JP','中国語（簡）':'簡','中国語（繁）':'繁','英語':'EN','ベトナム語':'VN','ミャンマー語':'MY','タイ語':'TH','インドネシア語':'ID','韓国語':'KR'};
