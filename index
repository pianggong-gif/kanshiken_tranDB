const drop2=document.getElementById('drop2');
drop2.addEventListener('dragover',e=>{e.preventDefault();drop2.classList.add('over');});
drop2.addEventListener('dragleave',()=>drop2.classList.remove('over'));
drop2.addEventListener('drop',e=>{e.preventDefault();drop2.classList.remove('over');loadFiles(e.dataTransfer.files);});
function loadFiles(files){
  const log=document.getElementById('imp-log');log.style.display='block';
  Array.from(files).forEach(f=>{
    const r=new FileReader();
    r.onload=e=>{
      try{
        const wb=XLSX.read(e.target.result,{type:'array'});
        let added=0;
        wb.SheetNames.forEach(sn=>{
          const rows=XLSX.utils.sheet_to_json(wb.Sheets[sn],{header:1,defval:''});
          if(rows.length<2)return;
          const headers=rows[0].map(h=>String(h).trim());
          const jpIdx=headers.findIndex(h=>h.includes('日本')||h==='JP'||h==='項目');
          if(jpIdx<0)return;
          const fn=f.name.toLowerCase();
          const src=fn.includes('oden')?'oden':fn.includes('taxi')?'taxi':fn.includes('benri')||fn.includes('life')?'life':'quest';
          rows.slice(1).forEach((row,ri)=>{
            const jp=String(row[jpIdx]||'').trim();
            if(!jp||DB.some(d=>d.src===src&&d.jp===jp))return;
            const langs={};
            headers.forEach((h,ci)=>{
              const m=LANGS.find(l=>h.includes(l.replace('（簡）','').replace('（繁）',''))||h.includes(LS[l]||''));
              if(m&&ci!==jpIdx)langs[m]=String(row[ci]||'').trim();
            });
            DB.push({id:`xl_${src}_${Date.now()}_${ri}`,src,cat:sn,jp,langs});added++;
          });
        });
        log.textContent+=`✓ ${f.name}: ${added} 件追加\n`;log.scrollTop=log.scrollHeight;
        buildSrcManage();
      }catch(err){log.textContent+=`✗ ${f.name}: ${err.message}\n`;}
    };r.readAsArrayBuffer(f);
  });
}
function buildSrcManage(){
  document.getElementById('src-manage').innerHTML=Object.entries(SRCS).map(([k,s])=>{
    const cnt=DB.filter(d=>d.src===k).length;
    return`<div style="background:var(--paper);border:1px solid var(--border);border-radius:8px;padding:10px 13px;margin-bottom:7px;display:flex;align-items:center;gap:9px">
      <span style="width:9px;height:9px;border-radius:50%;background:${s.color}"></span>
      <strong>${s.name}</strong>
      <span style="font-size:11px;color:var(--ink3)">${s.langs.length} 言語</span>
      <span style="margin-left:auto;font-weight:700;color:var(--teal)">${cnt} 件</span>
    </div>`;
  }).join('');
}

// ━━ ユーティリティ ━━
function cp(txt){navigator.clipboard.writeText(txt).then(()=>{const e=event.target;e.textContent='✓';e.style.color='var(--teal)';setTimeout(()=>{e.textContent='コピー';e.style.color='';},1200);});}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function expCSV(){
  const data=getFiltered();
  const showLangs=[...activeLangs].filter(l=>l!=='日本語');
  const hdr=['資料','カテゴリ','日本語',...showLangs].map(h=>`"${h}"`).join(',');
  const rows=data.map(d=>[SRCS[d.src]?.name||d.src,d.cat,d.jp,...showLangs.map(l=>d.langs[l]||'')].map(v=>`"${String(v).replace(/"/g,'""')}"`).join(','));
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob(['\uFEFF'+hdr+'\n'+rows.join('\n')],{type:'text/csv;charset=utf-8'}));
  a.download='kanshiken_multilang_db.csv';a.click();
}
// 初期化
buildSrcCards();buildLangPills();buildCatSel();render();buildSrcManage();
</script>
