// ━━ アンケートDBデータ（Q1〜Q20 全質問 5言語） ━━
const Q_DATA=[
  {id:'q01',cat:'基本情報',jp:'あなたの年齢は次のどれですか',langs:{'中国語（簡）':'您的年龄属于以下哪一项？','英語':'How old are you?','ベトナム語':'Bạn thuộc độ tuổi nào trong các mục dưới đây?','タイ語':'อายุของคุณคือช่วงใด','韓国語':'당신의 연령은 다음 중 무엇입니까？'}},
  {id:'q01a',cat:'基本情報',jp:'20〜29歳 / 30〜39歳 / 40〜49歳 / 50〜59歳 / 60歳以上',langs:{'中国語（簡）':'①20～29岁 ②30～39岁 ③40～49岁 ④50～59岁 ⑤60岁及以上','英語':'20–29 / 30–39 / 40–49 / 50–59 / 60+','ベトナム語':'20–29 tuổi / 30–39 tuổi / 40–49 tuổi / 50–59 tuổi / 60 tuổi trở lên','タイ語':'20–29 ปี / 30–39 ปี / 40–49 ปี / 50–59 ปี / 60 ปีขึ้นไป','韓国語':'①20～29세 ②30～39세 ③40～49세 ④50～59세 ⑤60세～'}},
