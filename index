const IV_DATA=[
  {id:'iv1',title:'外国人研修生インタビュー（日中バイリンガル）',color:'#8a1a5a',cls:'bdg-iv',desc:'FW合宿で外国人研修生・住民に実施',questions:[
    {no:'Q1',jp:'いつから日本で研修を始めましたか。どのような準備をしましたか。',zh:'什么时候开始来到日本研修的呢？都做了什么准备？'},
