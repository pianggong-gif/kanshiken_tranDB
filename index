// ━━ P3: 統計 ━━
function buildStats(){
  const bySrc=Object.entries(SRCS).map(([k,s])=>{
    const cnt=DB.filter(d=>d.src===k).length;
    const cats=[...new Set(DB.filter(d=>d.src===k).map(d=>d.cat))];
    return`<div style="background:var(--paper);border:1px solid var(--border);border-radius:9px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px">
      <span style="width:10px;height:10px;border-radius:50%;background:${s.color};flex-shrink:0"></span>
