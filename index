const DB=[
  ...MAIN_DATA,
  ...Q_DATA.map(q=>({...q,src:'quest'})),
];

let activeSrcs=new Set(Object.keys(SRCS));
let activeLangs=new Set(LANGS);

// ━━ パネル切替 ━━
function gp(i,btn){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('on'));
  document.querySelectorAll('.ntab').forEach(b=>b.classList.remove('on'));
  document.getElementById('p'+i).classList.add('on');
  btn.classList.add('on');
  window.scrollTo(0,0);
  if(i===0){buildSrcCards();buildLangPills();buildCatSel();render();}
  if(i===1){buildDetSelects();renderDetail();}
  if(i===2)renderIV();
  if(i===3)buildStats();
  if(i===4)buildSrcManage();
}

// ━━ P0 ━━
function buildSrcCards(){
  document.getElementById('src-cards').innerHTML=Object.entries(SRCS).map(([k,s])=>{
    const cnt=DB.filter(d=>d.src===k).length;
    return`<div class="src-card ${activeSrcs.has(k)?'on':''}" onclick="toggleSrc('${k}')">
      <span class="src-dot" style="background:${s.color}"></span>
      <div class="src-name">${s.name}</div>
      <div class="src-info">${s.langs.length} 言語</div>
      <span class="src-cnt">${cnt}</span></div>`;
  }).join('');
}
function toggleSrc(k){
  if(activeSrcs.has(k)){if(activeSrcs.size>1)activeSrcs.delete(k);}
  else activeSrcs.add(k);
  buildSrcCards();render();
}
function buildLangPills(){
  document.getElementById('lang-pills').innerHTML=['すべて',...LANGS].map(l=>{
    const isAll=l==='すべて';
    const on=isAll?activeLangs.size===LANGS.length:activeLangs.has(l);
    return`<div class="lp ${on?'on':''}" onclick="toggleLang('${l}')">${isAll?'全言語':LS[l]||l}</div>`;
  }).join('');
}
function toggleLang(l){
  if(l==='すべて'){activeLangs=new Set(LANGS);}
  else{if(activeLangs.has(l)){if(activeLangs.size>1)activeLangs.delete(l);}else activeLangs.add(l);}
  buildLangPills();render();
}
function buildCatSel(){
  const cats=[...new Set(DB.map(d=>d.cat))];
  const sel=document.getElementById('cat-sel');
  const prev=sel.value;
  sel.innerHTML='<option value="">すべてのカテゴリ</option>'+cats.map(c=>`<option ${prev===c?'selected':''}>${c}</option>`).join('');
}
function getFiltered(){
  const kw=document.getElementById('kw')?.value.toLowerCase().trim()||'';
  const cat=document.getElementById('cat-sel')?.value||'';
  const sort=document.getElementById('sort-sel')?.value||'src';
  let data=DB.filter(d=>{
    if(!activeSrcs.has(d.src))return false;
    if(cat&&d.cat!==cat)return false;
    if(kw){const all=[d.jp,...Object.values(d.langs)].join(' ').toLowerCase();if(!all.includes(kw))return false;}
    return true;
  });
  const srcKeys=Object.keys(SRCS);
  data.sort((a,b)=>{
    if(sort==='src')return srcKeys.indexOf(a.src)-srcKeys.indexOf(b.src)||a.jp.localeCompare(b.jp,'ja');
    if(sort==='jp')return a.jp.localeCompare(b.jp,'ja');
    if(sort==='cat')return a.cat.localeCompare(b.cat,'ja');
    return 0;
  });
  return data;
}
function render(){
  const data=getFiltered();
  const kw=document.getElementById('kw')?.value.trim()||'';
  const showLangs=[...activeLangs].filter(l=>l!=='日本語');
  document.getElementById('stats-bar').innerHTML=`
    <div class="stat"><div class="stat-v">${data.length}</div><div class="stat-l">表示中</div></div>
    <div class="stat"><div class="stat-v">${DB.length}</div><div class="stat-l">総件数</div></div>
    <div class="stat"><div class="stat-v">${[...activeSrcs].length}</div><div class="stat-l">選択資料</div></div>
    <div class="stat"><div class="stat-v">${showLangs.length}</div><div class="stat-l">表示言語</div></div>
    <div class="stat"><div class="stat-v">${IV_DATA.reduce((s,iv)=>s+iv.questions.length,0)}</div><div class="stat-l">インタビューQ</div></div>`;
  document.getElementById('cnt-lbl').textContent=data.length+' 件';
  document.getElementById('thead-row').innerHTML='<th>資料</th><th>カテゴリ</th><th>日本語</th>'+showLangs.map(l=>`<th>${LS[l]||l}</th>`).join('');
  const hl=s=>kw?String(s).replace(new RegExp('('+kw.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','gi'),'<mark>$1</mark>'):esc(s);
  document.getElementById('tbody').innerHTML=data.length
    ?data.map(d=>`<tr>
      <td class="src-tag"><span class="bdg ${SRCS[d.src]?.cls||'bdg-q'}">${SRCS[d.src]?.short||d.src}</span></td>
      <td class="cat-tag" style="font-size:11px;color:var(--ink3)">${d.cat}</td>
      <td class="jp">${hl(d.jp)}</td>
      ${showLangs.map(l=>{const v=d.langs[l]||'';return`<td class="lang-val">${hl(v)}${v?`<button class="cp" onclick="cp('${v.replace(/'/g,"\\'")}')">コピー</button>`:'<span style="color:var(--border2)">—</span>'}</td>`;}).join('')}
    </tr>`).join('')
    :`<tr><td colspan="99" class="empty">「${kw}」に一致するデータが見つかりませんでした</td></tr>`;
}

// ━━ P1: 詳細 ━━
function buildDetSelects(){
  const ds=document.getElementById('det-src');
  if(ds.options.length<=1)Object.entries(SRCS).forEach(([k,s])=>{const o=document.createElement('option');o.value=k;o.textContent=s.name;ds.appendChild(o);});
  const dc=document.getElementById('det-cat');
  if(dc.options.length<=1){[...new Set(DB.map(d=>d.cat))].forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;dc.appendChild(o);});}
}
