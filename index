        <span style="font-size:11px;color:var(--ink3)">${d.cat}</span>
        <strong style="font-size:13px">${esc(d.jp)}</strong>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:7px">
        ${LANGS.filter(l=>l!=='日本語').map(l=>{const v=d.langs[l]||'';
          return`<div style="background:var(--bg);border-radius:6px;padding:8px 10px">
            <div style="font-size:10px;font-weight:700;color:var(--ink3);margin-bottom:2px">${LS[l]||l} ${l}</div>
