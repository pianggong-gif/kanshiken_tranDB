  }).slice(0,20);
  document.getElementById('det-list').innerHTML=data.map(d=>`
    <div class="det-card">
      <div style="display:flex;align-items:center;gap:7px;margin-bottom:9px;padding-bottom:7px;border-bottom:1px solid var(--border)">
