  oden:{name:'静岡おでんおがわ',short:'おでん',color:'#8a5a0a',cls:'bdg-oden',langs:['日本語','中国語（簡）','中国語（繁）','英語','ベトナム語','ミャンマー語','タイ語','インドネシア語','韓国語']},
  taxi:{name:'川根本町 お出かけ号',short:'タクシー',color:'#1a5fa8',cls:'bdg-taxi',langs:['日本語','中国語（簡）','中国語（繁）','英語','ベトナム語','ミャンマー語','タイ語','インドネシア語','韓国語']},
