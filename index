      <span style="margin-left:auto;font-size:20px;font-weight:700;color:var(--teal)">${cnt} 件</span>
    </div>`;
  }).join('');
  const langCov=LANGS.filter(l=>l!=='日本語').map(l=>{
    const cnt=DB.filter(d=>d.langs[l]?.trim()).length;
    const pct=Math.round(cnt/DB.length*100);
    return`<div style="margin-bottom:6px">
      <div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:2px"><span>${l}</span><span style="font-weight:700;color:var(--teal)">${cnt}件 (${pct}%)</span></div>
      <div style="height:6px;background:var(--border);border-radius:3px;overflow:hidden"><div style="height:100%;background:var(--teal);width:${pct}%"></div></div>
    </div>`;
  }).join('');
  const ivTotal=IV_DATA.reduce((s,iv)=>s+iv.questions.length,0);
  document.getElementById('stats-detail').innerHTML=`
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin-bottom:16px">
      <div class="stat"><div class="stat-v">${DB.length}</div><div class="stat-l">翻訳DB総件数</div></div>
      <div class="stat"><div class="stat-v">${ivTotal}</div><div class="stat-l">インタビューQ数</div></div>
      <div class="stat"><div class="stat-v">${LANGS.length-1}</div><div class="stat-l">収録言語数</div></div>
      <div class="stat"><div class="stat-v">${IV_DATA.length}</div><div class="stat-l">インタビューシート</div></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
      <div><div class="lbl" style="margin-bottom:8px">資料別件数</div>${bySrc}</div>
      <div><div class="lbl" style="margin-bottom:8px">言語別カバレッジ</div>
        <div style="background:var(--paper);border:1px solid var(--border);border-radius:9px;padding:12px 14px">${langCov}</div>
      </div>
    </div>`;
}

